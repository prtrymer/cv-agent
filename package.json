{
  "name": "cv-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Job-application agent: discovers vacancies, triages them with an LLM, tailors CV + cover letter from a verified fact base, and gates every submission behind a human.",
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "fast-xml-parser": "^5.11.1",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.0.6",
    "ioredis": "^6.0.0",
    "mailparser": "^3.9.28",
    "pino": "^10.3.1",
    "playwright": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "start": "tsx src/web/server.ts",
    "cli": "tsx src/cli.ts",
    "run": "tsx src/cli.ts run",
    "add": "tsx src/cli.ts add",
    "mark": "tsx src/cli.ts mark",
    "review": "tsx src/cli.ts review",
    "apply": "tsx src/cli.ts apply",
    "report": "tsx src/cli.ts report",
    "doctor": "tsx src/cli.ts doctor",
    "demo": "tsx src/cli.ts run --config config/demo.yaml --fresh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  }
}
