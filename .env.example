# Copy to .env and fill in. Never commit .env.
LLM_API_KEY=                       # OpenRouter key (or your MiMo platform key if llm.baseUrl points there)
REDIS_URL=redis://localhost:6379   # optional; without it the cache falls back to SQLite
LOG_LEVEL=warn        # terminal shows progress lines + problems; full detail is in logs/agent.log
# Job-alert emails (alerts.enabled in config/agent.yaml). Gmail: turn on 2-Step Verification, then create an
# app password at https://myaccount.google.com/apppasswords — never your real password. Access is read-only.
IMAP_USER=
IMAP_PASSWORD=
